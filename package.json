{
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:up": "docker compose up --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up --wait postgres",
    "local:check-env": "node scripts/check-local-env-example.mjs",
    "local:check-readme": "node scripts/check-readme-local-setup.mjs",
    "local:setup": "pnpm local:check-env && pnpm db:up && pnpm prisma:generate && pnpm prisma:migrate",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:reset": "prisma migrate reset --schema prisma/schema.prisma --force",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
